{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node scripts/vercel-build.mjs",
  "crons": [
    {
      "path": "/api/cron/purge",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/render-worker",
      "schedule": "* * * * *"
    }
  ]
}
