{
  "name": "project-visualizer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "next@16.3.6": {
      "postcss": "8.5.25"
    },
    "nanoid@>=3 <3.3.18": "3.3.18",
    "js-yaml@>=4 <4.3.2": "4.3.2",
    "vitest": "4.1.11"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @visualizer/web",
    "preview:boutique": "node apps/web/scripts/preview-storefront-local.mjs",
    "build": "npm run build --workspace @visualizer/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:unit",
    "test:unit": "npm run test --workspace @lili/geometry && npm run test --workspace @lili/ai-router && npm run test --workspace @lili/types && npm run test --workspace @visualizer/web",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "node apps/web/scripts/test-e2e-isolated.mjs",
    "migrate:image-pipeline": "node apps/web/scripts/migrate-image-pipeline.mjs",
    "migrate:asset-visibility": "node apps/web/scripts/migrate-asset-visibility.mjs",
    "migrate:cutout-provenance": "node apps/web/scripts/migrate-cutout-provenance.mjs",
    "migrate:oriented-views": "node --conditions=react-server --env-file-if-exists=.env --import tsx apps/web/scripts/migrate-oriented-views.ts",
    "check:oriented": "node --env-file-if-exists=.env apps/web/scripts/oriented-readiness.mjs",
    "corpus:run": "node apps/web/scripts/corpus-run.mjs",
    "corpus:aggregate": "node apps/web/scripts/corpus-aggregate.mjs",
    "corpus:compare": "node apps/web/scripts/corpus-comparison.mjs",
    "corpus:validate": "node apps/web/scripts/corpus-validate.mjs",
    "worker:render": "node --conditions=react-server --env-file-if-exists=.env --import tsx apps/web/scripts/render-worker.ts",
    "test:durable": "npm run test --workspace @visualizer/web -- tests/durable-steps.test.ts tests/durable-queue.test.ts",
    "test:durable:integration": "node apps/web/scripts/test-durable-integration.mjs",
    "test:release": "node --test apps/web/scripts/test-vercel-build.mjs apps/web/scripts/test-prepare-release-candidate.mjs apps/web/scripts/test-production-smoke.mjs apps/web/scripts/test-oriented-readiness.mjs testpratiques/scripts/test-production-preflight-policy.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "mongodb-memory-server": "10.2.3",
    "prettier": "^3.6.2",
    "tsx": "4.20.6"
  }
}
