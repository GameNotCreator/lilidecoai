# Application
DEMO_MODE=true
APP_SESSION_SECRET=replace-with-at-least-32-random-characters

# Back office /admin — sans ces variables l'interface reste verrouillée.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-passphrase
# Alternative recommandée en production : hash bcrypt au lieu du mot de passe clair.
# node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" "votre-mot-de-passe"
ADMIN_PASSWORD_HASH=
# Facultatif : secret dédié aux sessions du back office (sinon APP_SESSION_SECRET).
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=12
# Boutique alimentée par la banque de produits.
ADMIN_ORGANIZATION_SLUG=atelier-lili
ADMIN_ORGANIZATION_NAME=Atelier Lili

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/lilidecoai
MONGODB_DB=lilidecoai

# Cloudinary — server only. CLOUDINARY_URL suffit à elle seule.
CLOUDINARY_URL=
CLOUDINARY_UPLOAD_FOLDER=lilidecoai

# Alternative à CLOUDINARY_URL
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Temporary room-photo retention and Vercel upload limit
MAX_UPLOAD_BYTES=4000000
ROOM_RETENTION_HOURS=24
CRON_SECRET=replace-with-a-random-cron-secret

# GPT Image 2 — server only, fournisseur actif de la démo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-2
OPENAI_IMAGE_ENABLED=true
OPENAI_QUALITY=high
OPENAI_MAX_COST_USD=0.25
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MOCK_MODE=true

# Ancien pipeline Google, conservé pour les parcours marchands existants
GOOGLE_AI_API_KEY=
# Alias accepte si votre variable Vercel s'appelle deja GEMINI_API_KEY.
GEMINI_API_KEY=
GOOGLE_PREVIEW_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_FINAL_IMAGE_MODEL=gemini-3-pro-image
GOOGLE_IMAGE_TIMEOUT_MS=240000
GOOGLE_IMAGE_MAX_RETRIES=1
GOOGLE_IMAGE_MAX_COST_USD=0.45
IMAGE_PIPELINE_MODE=google_hybrid
OPENAI_VISION_MODEL=gpt-5.6-sol
OPENAI_SERVICE_TIER=fast
