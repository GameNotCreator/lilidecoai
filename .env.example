# Runtime
ENVIRONMENT=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./services/api/visualizer.db
PUBLIC_API_URL=http://127.0.0.1:8000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SIGNED_URL_SECRET=development-only-change-me
MAX_UPLOAD_BYTES=12582912
MIN_IMAGE_DIMENSION=320
ROOM_RETENTION_HOURS=24

# Production database / queue / object storage
POSTGRES_DB=visualizer
POSTGRES_USER=visualizer
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_BUCKET=visualizer
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me

# OpenAI Image — server only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-2
OPENAI_QUALITY=medium
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=1
OPENAI_MAX_COST_USD=0.25
OPENAI_BASE_URL=https://api.openai.com/v1

# Auth / observability
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
POSTHOG_KEY=
SENTRY_DSN=

# Konnect — server only
KONNECT_API_KEY=
KONNECT_WEBHOOK_SECRET=
KONNECT_BASE_URL=https://api.konnect.network/api/v2
