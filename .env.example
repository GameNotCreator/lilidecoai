# Application
DEMO_MODE=true
APP_SESSION_SECRET=replace-with-at-least-32-random-characters

# Back office /admin — le secret APP_SESSION_SECRET reste obligatoire.
ADMIN_CREDENTIALS_MODE=fixed
# Le compte LiliDeco est défini côté serveur. Pour une rotation volontaire :
# ADMIN_CREDENTIALS_MODE=environment puis ADMIN_USERNAME/ADMIN_PASSWORD_HASH.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Alternative recommandée en production : hash bcrypt au lieu du mot de passe clair.
# node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" "votre-mot-de-passe"
ADMIN_PASSWORD_HASH=
# Facultatif : secret dédié aux sessions du back office (sinon APP_SESSION_SECRET).
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=12
# Boutique alimentée par la banque de produits.
ADMIN_ORGANIZATION_SLUG=atelier-lili
ADMIN_ORGANIZATION_NAME=LiliDeco
# Coupe uniquement la nouvelle visualisation boutique, conserve catalogue/panier.
STOREFRONT_VISUALIZATION_ENABLED=true
# Production concept store : aucune création publique de compte marchand/crédits.
MERCHANT_SIGNUP_ENABLED=false

# Demandes de commande — variables serveur, aucun paiement en ligne.
STOREFRONT_ORDERS_ENABLED=false
RESEND_API_KEY=
# Adresse appartenant à un domaine vérifié dans Resend.
RESEND_FROM_EMAIL=
ORDER_EMAIL_TO=bylilideco.tunisie@gmail.com
ORDER_REQUEST_RETENTION_DAYS=90
# Facultatif uniquement en développement pour le QR : origine du site
# accessible depuis le téléphone (HTTPS, ou IPv4 privée avec HTTP).
NEXT_PUBLIC_STOREFRONT_MOBILE_ORIGIN=

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/lilidecoai
MONGODB_DB=lilidecoai

# Cloudinary — server only. CLOUDINARY_URL suffit à elle seule.
CLOUDINARY_URL=
CLOUDINARY_UPLOAD_FOLDER=lilidecoai

# Alternative à CLOUDINARY_URL
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Temporary room-photo retention and Vercel upload limit
MAX_UPLOAD_BYTES=4000000
ROOM_RETENTION_HOURS=24
CRON_SECRET=replace-with-a-random-cron-secret

# Génération de qualité maximale — server only
# Insertion boutique v6 : OpenAI Responses crée une nouvelle vue transparente
# (Astra low + modèle image figé), puis MyArchitectAI intègre lumière/contact RGB.
# La texture native intérieure est restaurée sous cet éclairage local.
# Petites projections et remplacements : MyArchitectAI puis une seule édition
# locale opaque OpenAI avec catalogue et pièce entière ; région bornée, fond protégé.
# Le premier résultat conserve sa résolution native, masque et coordonnées alignés.
# Un guide distinct marque contact/largeur ; l'image de base reste sans annotation.
# OpenAI contrôle ensuite identité, perspective, échelle et intégration.
# Les sélections de plusieurs produits restent traitées par OpenAI.
SIMPLE_POINT_IMAGE_PROVIDER=myarchitectai
MYARCHITECTAI_API_KEY=
MYARCHITECTAI_TIMEOUT_MS=120000
# Estimation comptable par édition ; ne recharge pas le compte fournisseur.
MYARCHITECTAI_EDIT_COST_USD=0.03
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-2.5-sunburst
# Vue native alpha et édition locale opaque de la boutique.
STOREFRONT_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_ENABLED=true
OPENAI_VISION_REASONING=high
OPENAI_QUALITY=max
OPENAI_MAX_COST_USD=5
# Garde-fou contre les boucles, pas un objectif de coût par rendu.
RENDER_MAX_COST_USD=20
# Progressive rollout: web (legacy) or durable (simple_point and standard).
# Durable mode requires MongoDB replica set/Atlas and the Vercel or Node worker.
RENDER_EXECUTION_MODE=web
# Développement seulement. En production : identité du manifeste sha256:...,
# ou supprimer cette variable pour utiliser le commit Vercel complet.
RENDER_WORKER_REVISION=local
RENDER_DEADLINE_SECONDS=1800
# La boutique a une limite distincte de 180 s, attente comprise.
# Capture de diagnostic uniquement ; conserver false pour la publication.
RENDER_STAGE_CAPTURE=false
RENDER_WORKER_CONCURRENCY=2
RENDER_GLOBAL_CONCURRENCY=4
RENDER_TENANT_CONCURRENCY=2
# Optional HTTPS origin of this deployment's worker. On Vercel, VERCEL_URL
# supplies the deployment origin automatically. Never set from a client URL.
RENDER_WORKER_ORIGIN=
# If Vercel Deployment Protection is enabled, configure its automation bypass
# secret in the server environment (not NEXT_PUBLIC_*); see infra/render-worker.md.
VERCEL_AUTOMATION_BYPASS_SECRET=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MOCK_MODE=true

# Ancien pipeline Google, conservé pour les parcours marchands existants
GOOGLE_AI_API_KEY=
# Alias accepte si votre variable Vercel s'appelle deja GEMINI_API_KEY.
GEMINI_API_KEY=
GOOGLE_PREVIEW_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_FINAL_IMAGE_MODEL=gemini-3-pro-image
GOOGLE_IMAGE_TIMEOUT_MS=240000
GOOGLE_IMAGE_MAX_RETRIES=1
GOOGLE_IMAGE_MAX_COST_USD=0.45
IMAGE_PIPELINE_MODE=google_hybrid
OPENAI_VISION_MODEL=gpt-6-astra
OPENAI_SERVICE_TIER=default

# Private segmentation worker; server only. Product cutout keeps its heuristic
# when empty. Spatial v12 requires this service before admitting a paid job.
# Production uses HTTPS. Plain HTTP is allowed only on loopback for local checks.
# Pinned BiRefNet-lite hash and runtime: infra/spatial-volume-v12.md.
MATTING_URL=
# Use a random printable ASCII secret without spaces or control characters.
MATTING_TOKEN=
MATTING_TIMEOUT_MS=60000
# Internal spatial pilot: explicit organization IDs, comma separated. Empty disables new spatial jobs.
# Requires RENDER_EXECUTION_MODE=durable and a real OpenAI image provider.
SPATIAL_ORGANIZATION_IDS=
# Default admission: explicitly declared solid-base baskets/vases with catalog
# or measured dimensions. This setting alone does not activate any organization.
SPATIAL_ADMISSION_MODE=solid-base-only
# internal-all is reserved for qualification; it also admits legacy v11 families.
# The service itself separately receives MATTING_TOKEN and a prebuilt local model.
# Never expose these values through NEXT_PUBLIC_* or commit an environment file.
# Public canonical origin for metadata and sitemap. No path, credentials or query.
SITE_URL=https://lilidecoai-web.vercel.app
