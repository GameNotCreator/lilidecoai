FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
# No Next build is needed for the standalone worker. Include tsx from the
# locked development dependencies; no credentials are copied into the image.
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages packages
RUN npm ci --include=dev --ignore-scripts
COPY apps/web/lib apps/web/lib
COPY apps/web/scripts/render-worker.ts apps/web/scripts/render-worker.ts
COPY apps/web/tsconfig.json apps/web/tsconfig.json
USER node
CMD ["node", "--conditions=react-server", "--import", "tsx", "apps/web/scripts/render-worker.ts"]
